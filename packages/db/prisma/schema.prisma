generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String?   @unique
  passwordHash  String?
  displayName   String?
  bio           String?
  avatarUrl     String?
  role          Role      @default(USER)
  language      String    @default("en")
  timezone      String    @default("UTC")
  isNsfwVisible Boolean   @default(false)
  createdAt     DateTime  @default(now())
  bannedUntil   DateTime?

  images        Image[]
  albums        Album[]
  sessions      Session[]
  likes         Like[]
  notifications Notification[]
  followers     Follow[] @relation("Followers")
  following     Follow[] @relation("Following")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Image {
  id               String    @id @default(cuid())
  userId           String
  albumId          String?
  categoryId       String?
  title            String?
  description      String?
  originalFilename String
  storageKey       String
  width            Int
  height           Int
  sizeBytes        Int
  mimeType         String
  hash             String?
  thumbUrl         String?
  mediumUrl        String?
  isNsfw           Boolean   @default(false)
  isPrivate        Boolean   @default(false)
  viewsCount       Int       @default(0)
  likesCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  album            Album?    @relation(fields: [albumId], references: [id])
  category         Category? @relation(fields: [categoryId], references: [id])
  likes            Like[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  
  images      Image[]
}

model Album {
  id           String   @id @default(cuid())
  userId       String
  name         String
  slug         String   @unique
  description  String?
  privacy      Privacy  @default(PUBLIC)
  passwordHash String?
  coverImageId String?
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  images       Image[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  imageId   String?
  albumId   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  image     Image?   @relation(fields: [imageId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BanList {
  id        String   @id @default(cuid())
  ip        String?  @unique
  userId    String?
  reason    String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

enum Role {
  GUEST
  USER
  MODERATOR
  ADMIN
}

enum Privacy {
  PUBLIC
  PRIVATE
  UNLISTED
  PASSWORD
}
